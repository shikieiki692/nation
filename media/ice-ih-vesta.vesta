# VESTA input file: Ice Ih (Hexagonal Ice)
# Space group: P6₃/mmc (194)
# Cell parameters: a = 4.5227 Å, c = 7.3671 Å
# O fractional coordinates from neutron diffraction (Peterson & Levy, 1957)
# Reference: 赵鑫光 Ch4; Atkins Physical Chemistry
#
# Usage: Open in VESTA → Adjust view → File > Export Raster Image
# Note: H atoms omitted in this file. In real ice Ih, each O has 2 covalent H
#       and 2 hydrogen-bonded H. Use VESTA's "Edit > Bonds" to add O-H bonds.
#
# Key features to show:
#   - Hexagonal symmetry of the oxygen sublattice
#   - Tetrahedral coordination of each O (CN=4)
#   - Open structure (density 0.917 g/cm³ < liquid water)
#   - Hydrogen bonding O-H···O along c-axis and basal plane

STRUCTURAL_PARAMETER
  TITLE = Ice Ih (Hexagonal Ice)
  SPACE_GROUP = 194
  CELL_LENGTH_A = 4.5227
  CELL_LENGTH_B = 4.5227
  CELL_LENGTH_C = 7.3671
  CELL_ANGLE_ALPHA = 90.0
  CELL_ANGLE_BETA  = 90.0
  CELL_ANGLE_GAMMA = 120.0
END_STRUCTURAL_PARAMETER

SITE
  DISPLAY = true
  LABEL = O
  SITE_FRACTION = 1.0
  STYLE = BALLANDSTICK
  COLOR = 200,30,30
  ATOM = O  0.000000  0.000000  0.000000
END_SITE

SITE
  DISPLAY = true
  LABEL = O
  SITE_FRACTION = 1.0
  STYLE = BALLANDSTICK
  COLOR = 200,30,30
  ATOM = O  0.000000  0.000000  0.375000
END_SITE

SITE
  DISPLAY = true
  LABEL = O
  SITE_FRACTION = 1.0
  STYLE = BALLANDSTICK
  COLOR = 200,30,30
  ATOM = O  0.666667  0.333333  0.500000
END_SITE

SITE
  DISPLAY = true
  LABEL = O
  SITE_FRACTION = 1.0
  STYLE = BALLANDSTICK
  COLOR = 200,30,30
  ATOM = O  0.666667  0.333333  0.875000
END_SITE

# O-O distances:
#   Intralayer:  a/√3 ≈ 2.757 Å  (along c-axis O-H···O)
#   Interlayer:   a ≈ 4.523 Å
# Each O is tetrahedrally coordinated by 4 neighbors
# 2 O-H covalent bonds (~0.97 Å) + 2 O···H hydrogen bonds (~1.75 Å)
