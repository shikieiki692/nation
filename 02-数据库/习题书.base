filters:
  and:
    - or:
        - file.inFolder("04-题库")
        - file.inFolder("05-真题库")
    - or:
        - type == "题目"
        - type == "真题"
    - teaching_level == "拓展"
properties:
  file.name:
    displayName: 题目
  file.folder:
    displayName: 所在目录
  subject_module:
    displayName: 模块
  submodule:
    displayName: 子模块
  pack:
    displayName: 层级
  difficulty:
    displayName: 难度
  exam_stage:
    displayName: 阶段
  fidelity:
    displayName: 保真
  teaching_level:
    displayName: 层次
  question_type:
    displayName: 题型
  concepts:
    displayName: 细粒度概念
  knowledge_points:
    displayName: 知识点
  source_subject:
    displayName: 来源科目
  status:
    displayName: 状态
  used_in:
    displayName: 已用于
views:
  - type: table
    name: 全部（拓展）
    order:
      - file.name
      - subject_module
      - submodule
      - difficulty
      - exam_stage
      - fidelity
      - question_type
      - status
    sort:
      - property: subject_module
        direction: ASC
      - property: difficulty
        direction: ASC
  - type: table
    name: 未用过的题（组卷新鲜池）
    filters:
      and:
        - used_in.isEmpty()
    order:
      - file.name
      - subject_module
      - submodule
      - difficulty
      - exam_stage
      - fidelity
      - question_type
    sort:
      - property: subject_module
        direction: ASC
      - property: difficulty
        direction: ASC
  - type: table
    name: 待填充
    filters:
      and:
        - status == "待填充"
    order:
      - file.name
      - file.folder
      - subject_module
      - difficulty
    sort:
      - property: file.folder
        direction: ASC
      - property: file.name
        direction: ASC
